	(text "Rev 7 pre-build (2026-11-13). KL30 engine-running switch: U3 TL431B + Q1 PNP.\nOn ~13.2 V, off ~12.8 V (+/-0.2 V). JP4 1-2 = KL15 (UVLO ~7.7 V via Ren1/Ren2), 2-3 = KL30.\nOption (not fitted): TJA1043T/1J (SOIC-14, C140826) for CAN wake on KL30, INH -> JP4 KL30 pad."
		(exclude_from_sim no)
		(at 119.38 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "06568ca5-c750-4bfb-8431-2da9e6f196d8")
	)
	(text "Power entry: J7 -> F1 -> VBAT_IN (D6 TVS, RV1 DNP) -> D7 -> VBAT_PROT (C1, C13) -> FB1 -> VIN"
		(exclude_from_sim no)
		(at 96.52 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2b3107c2-16b4-4378-b908-a2a990c8fb22")
	)
	(text "CAN TX = GPIO17, RX = GPIO16 on all headers (J3.6/J3.8, J5.2/J5.4, J6.3/J6.1).\nGPIO43/44 (UART0) freed. C18 STB RC not fitted (CAN no longer on UART0)."
		(exclude_from_sim no)
